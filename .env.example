# Copy to .env.local for development, or set these in your host's build settings.
# NEXT_PUBLIC_* values are inlined into the static build, so rebuild after changing them.

# Overrides siteConfig.whatsapp. Digits only, with country code, no "+".
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Rotate the public Web3Forms access key without editing source.
NEXT_PUBLIC_WEB3FORMS_KEY=

# Optional: enable Google Analytics 4. Leave empty to disable analytics entirely.
NEXT_PUBLIC_GA_ID=

# Planned Netlify + Resend integration (not used by the current static export).
RESEND_API_KEY=
NOTIFY_EMAIL=
FROM_EMAIL=
