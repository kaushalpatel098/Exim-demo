# Copy to .env.local for development, or configure these in your hosting provider.

# Overrides siteConfig.whatsapp. Digits only, with country code, no "+".
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Optional: enable Google Analytics 4. Leave empty to disable analytics entirely.
NEXT_PUBLIC_GA_ID=

# Server-only Resend credentials. FROM_EMAIL must use a verified Resend domain.
RESEND_API_KEY=re_replace_with_your_resend_api_key
NOTIFY_EMAIL=ceo@p-i-e-group.com
FROM_EMAIL=Prithvi International Exim LLP <website@p-i-e-group.com>
